# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Required for the first administrator account. Use a unique password with at
# least 12 characters. Keep this file private and never commit it.
ADMIN_NIP="REPLACE_WITH_ADMIN_NIP"
ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS"

# SQLite database directory. Back this directory up regularly.
DATA_DIRECTORY="data"
# On hosting, set this to a persistent absolute directory outside the deployed source.

# Optional listener address. Development defaults to 127.0.0.1;
# production defaults to 0.0.0.0 for the hosting reverse proxy.
# HOST="0.0.0.0"

# Public HTTPS origin used to generate links in WhatsApp messages.
# APP_PUBLIC_URL="https://bmn.bpsminut.go.id"

# Optional: exact Tailscale hostname allowed by Vite, e.g. siman.example.ts.net
# TUNNEL_HOST=""

# Meta WhatsApp Cloud API. Keep the access token in this server-side .env only.
WHATSAPP_PROVIDER="meta"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# When set, notification events go only to this test recipient and are labeled as tests.
# Remove this setting after testing to restore the existing role-based recipients.
WHATSAPP_RECIPIENT_NUMBER=""
WHATSAPP_GRAPH_API_VERSION="v23.0"
# Optional: approved template with one body placeholder ({{1}}) for messages
# sent outside WhatsApp's 24-hour customer service window.
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="id"

# Fonnte. Set WHATSAPP_PROVIDER="fonnte" to use this provider.
# Keep both secrets only in this backend .env or the hosting secret manager.
FONNTE_TOKEN=""
FONNTE_API_URL="https://api.fonnte.com/send"
FONNTE_WEBHOOK_SECRET=""

# Twilio WhatsApp. Select WHATSAPP_PROVIDER="twilio" to use these settings.
# TWILIO_API_KEY is the API Key SID (starts with SK), not its secret.
TWILIO_ACCOUNT_SID=""
TWILIO_API_KEY=""
TWILIO_API_KEY_SECRET=""
# Twilio WhatsApp-enabled sender, e.g. whatsapp:+14155238886 for the Sandbox.
TWILIO_WHATSAPP_FROM=""
