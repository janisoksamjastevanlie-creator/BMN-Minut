# Groq classifies WhatsApp questions into a fixed allowlist of intents.
# Only the incoming message text is sent to Groq; database records stay server-side.
WHATSAPP_AI_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
WHATSAPP_AI_ENABLED="true"

# Optional legacy provider. Set WHATSAPP_AI_PROVIDER="gemini" to use it.
GEMINI_API_KEY=""
WHATSAPP_AI_MODEL="gemini-2.5-flash"

# Legacy development mode only. Operational mode never seeds an administrator.
ADMIN_NIP="REPLACE_WITH_ADMIN_NIP"
ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS"

# Use only a verified staging database while developing/testing.
DATA_BACKEND="legacy"
DB_HOST="127.0.0.1"
DB_PORT="3308"
DB_USER=""
DB_PASSWORD=""
DB_NAME=""
DB_CONNECTION_LIMIT="10"

# Batas runtime agar server tidak pernah tampak "diam" tanpa jawaban.
# DB_QUEUE_LIMIT  : maksimal permintaan yang boleh mengantre menunggu koneksi database;
#                   sisanya langsung dijawab 503 (Retry-After) alih-alih menggantung.
# DB_ACQUIRE_TIMEOUT_MS : batas tunggu memperoleh koneksi untuk transaksi.
# STATE_CACHE_TTL_MS    : umur pakai cache state penuh; 0 berarti membaca ulang
#                   basis data pada setiap permintaan authenticate (paling lambat).
# STATE_WRITE_CONCURRENCY : jumlah penyimpanan state (PUT /api/state) yang diproses
#                   bersamaan; permintaan tambahan menunggu di antrian singkat.
# REQUEST_TIMEOUT_MS / STATE_REQUEST_TIMEOUT_MS : batas waktu jawaban API biasa dan
#                   sinkronisasi state; melampauinya server mengirim 504.
# AUDIT_RETENTION_DAYS : umur audit trail yang tetap berada di state aktif. 0 berarti
#                   tidak pernah memindahkan catatan (bawaan). Nilai > 0 memindahkan
#                   entri lebih tua ke tabel audit_log_archive, bukan menghapusnya;
#                   mode operasional memerlukan migrations/audit-log-archive-v1.sql.
# AUDIT_RETENTION_INTERVAL_MS : jeda pemeriksaan retensi (bawaan 6 jam).
# AUDIT_ACTIVE_LIMIT : jumlah catatan audit terbaru yang boleh ikut dalam state aktif.
#                   0 berarti tidak dibatasi (bawaan). Lonjakan impor data pernah
#                   membuat auditLogs mencapai 3,6 MB (11.161 entri) sehingga setiap
#                   login membaca dan setiap simpanan menulis ulang payload besar;
#                   nilai seperti 2000 menahan ukuran itu tanpa membuang catatan.
# HEALTH_HISTORY_INTERVAL_MS : jeda pencatatan riwayat beban ke tabel health_samples
#                   (bawaan 5 menit). Keluaran proses pada hosting terkelola tidak
#                   bertahan, jadi riwayat ini yang membuat gangguan semalam masih
#                   bisa dibaca pagi harinya lewat /api/health/detail. 0 mematikan.
# HEALTH_HISTORY_RETENTION_DAYS : berapa lama baris riwayat disimpan (bawaan 7 hari).
DB_QUEUE_LIMIT="50"
DB_ACQUIRE_TIMEOUT_MS="20000"
STATE_CACHE_TTL_MS="2000"
STATE_WRITE_CONCURRENCY="3"
STATE_WRITE_QUEUE_LIMIT="20"
REQUEST_TIMEOUT_MS="30000"
STATE_REQUEST_TIMEOUT_MS="105000"
SLOW_REQUEST_LOG_MS="2000"
EVENT_LOOP_LAG_THRESHOLD_MS="300"

# GZIP_MINIMUM_BYTES : respons API yang lebih besar dari ini dimampatkan sebelum
#                   dikirim. State penuh pernah 6,85 MB per tarikan dan setiap tab
#                   yang sinkron otomatis membacanya; pada pengukuran lokal 802 KB
#                   menjadi 55 KB (6,8%) tanpa menambah waktu tunggu. Set 0 untuk
#                   memampatkan semua respons JSON, termasuk yang kecil.
GZIP_MINIMUM_BYTES="1024"
AUDIT_RETENTION_DAYS="0"
AUDIT_RETENTION_INTERVAL_MS="21600000"
AUDIT_ACTIVE_LIMIT="0"
HEALTH_HISTORY_INTERVAL_MS="300000"
HEALTH_HISTORY_RETENTION_DAYS="7"

# Private files are stored outside public/dist; set an absolute persistent path on hosting.
DOCUMENT_STORAGE_DIR=""
DOCUMENT_MAX_FILE_SIZE_MB="25"

# Optional listener address. Production requires DATA_BACKEND=operational and
# defaults to 0.0.0.0 behind the intended private reverse proxy/Tunnel.
# HOST="0.0.0.0"

# Public HTTPS origin used to generate links in WhatsApp messages.
# APP_PUBLIC_URL="https://bmn.bpsminut.go.id"

# Cloudflare Access. Production mode always requires Access and fails startup if
# either value is missing. Obtain both values from the Cloudflare administrator.
ACCESS_REQUIRED="false"
CLOUDFLARE_ACCESS_TEAM_DOMAIN=""
CLOUDFLARE_ACCESS_AUD=""

# Optional: exact Tailscale hostname allowed by Vite, e.g. siman.example.ts.net
# TUNNEL_HOST=""

# Meta WhatsApp Cloud API. Keep the access token in this server-side .env only.
WHATSAPP_PROVIDER="meta"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# When set, notification events go only to this test recipient and are labeled as tests.
# Remove this setting after testing to restore the existing role-based recipients.
WHATSAPP_RECIPIENT_NUMBER=""
WHATSAPP_GRAPH_API_VERSION="v23.0"
# Optional: approved template with one body placeholder ({{1}}) for messages
# sent outside WhatsApp's 24-hour customer service window.
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="id"

# Fonnte. Set WHATSAPP_PROVIDER="fonnte" to use this provider.
# Keep both secrets only in this backend .env or the hosting secret manager.
FONNTE_TOKEN=""
FONNTE_API_URL="https://api.fonnte.com/send"
FONNTE_WEBHOOK_SECRET=""

# Optional chatbot controls. Use the connected Fonnte device number for loop protection.
WHATSAPP_BOT_NUMBER=""
# Set true only after verifying this number against the connected Fonnte device.
# Controls the website WhatsApp link only; does not enable or change notifications.
WHATSAPP_BOT_VERIFIED="false"
WHATSAPP_RATE_LIMIT_MAX="15"
WHATSAPP_RATE_LIMIT_WINDOW_SECONDS="60"
WHATSAPP_REMINDERS_ENABLED="true"
WHATSAPP_REMINDER_HOUR="8"

# Twilio WhatsApp. Select WHATSAPP_PROVIDER="twilio" to use these settings.
# TWILIO_API_KEY is the API Key SID (starts with SK), not its secret.
TWILIO_ACCOUNT_SID=""
TWILIO_API_KEY=""
TWILIO_API_KEY_SECRET=""
# Twilio WhatsApp-enabled sender, e.g. whatsapp:+14155238886 for the Sandbox.
TWILIO_WHATSAPP_FROM=""

# Optional outbound BMN-Minut request events to an n8n HTTPS webhook.
# Keep this disabled until the imported workflow and its Header Auth credential are configured.
N8N_ENABLED="false"
N8N_BASE_URL=""
N8N_ALLOWED_HOSTS=""
N8N_WEBHOOK_PATH="/webhook/bmn-minut/events"
N8N_WEBHOOK_SECRET=""
N8N_TIMEOUT_MS="10000"

# Optional website AI provider override. Defaults to the configured WhatsApp AI provider.
# When set to "n8n", the backend sends only sanitized chat history and permission-filtered context.
WEB_CHAT_AI_PROVIDER=""
WEB_CHAT_AI_ENABLED=""
N8N_CHAT_WEBHOOK_URL=""
N8N_CHAT_WEBHOOK_SECRET=""
N8N_CHAT_TIMEOUT_MS="25000"
