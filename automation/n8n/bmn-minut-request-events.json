    {
      "parameters": {
        "jsCode": "const event = $json.body;\nconst statusByType = {\n  'request.submitted': 'Diajukan',\n  'request.verified': 'Diverifikasi',\n  'request.approved': 'Disetujui',\n  'request.rejected': 'Ditolak',\n  'request.processing': 'Diproses',\n  'request.completed': 'Selesai',\n  'request.cancelled': 'Dibatalkan'\n};\nconst statuses = new Set(['Draft', 'Diajukan', 'Diverifikasi', 'Disetujui', 'Diproses', 'Selesai', 'Ditolak']);\nconst eventId = typeof event?.eventId === 'string' && /^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(event.eventId);\nconst requestId = typeof event?.data?.requestId === 'string' && event.data.requestId.length > 0 && event.data.requestId.length <= 100;\nconst currentStatusValid = event?.data?.status === statusByType[event?.eventType];\nconst previousStatusValid = event?.eventType === 'request.submitted'\n  ? event?.data?.previousStatus === null\n  : statuses.has(event?.data?.previousStatus);\nconst timestamp = Number($json.headers?.['x-bmn-timestamp']);\nconst fresh = Number.isInteger(timestamp) && Math.abs(Math.floor(Date.now() / 1000) - timestamp) <= 300;\nconst valid = event?.schemaVersion === 1 && eventId && currentStatusValid && previousStatusValid && requestId && fresh && typeof event?.occurredAt === 'string' && !Number.isNaN(Date.parse(event.occurredAt));\nreturn [{ json: { valid, eventId: event?.eventId, eventType: event?.eventType } }];"
      },
