    {
      "parameters": {
        "jsCode": "const messages = $json.body?.messages;\nconst validText = value => typeof value === 'string' && value.length > 0 && value.length <= 30000;\nconst valid = Array.isArray(messages) && messages.length >= 2 && messages.length <= 9 &&\n  messages[0]?.role === 'system' && validText(messages[0]?.content) &&\n  messages.slice(1).every(message => ['user', 'assistant'].includes(message?.role) && validText(message?.content) && message.content.length <= 1200) &&\n  messages[messages.length - 1]?.role === 'user';\nif (!valid) return [{ json: { valid: false, error: 'Invalid chat request.' } }];\nconst system = messages[0].content;\nconst prompt = messages.slice(1).map(message => `${message.role === 'user' ? 'Pengguna' : 'Asisten'}: ${message.content}`).join('\\n');\nreturn [{ json: { valid: true, system, prompt } }];"
      },
      "id": "74d871c9-51c0-4d82-92a1-a680c5fd65b7",
      "name": "Validate chat envelope",
      "type": "n8n-nodes-base.code",
